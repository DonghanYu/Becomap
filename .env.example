# Supabase 프로젝트 값 (.env.local에 복사해 입력, 커밋 금지)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 탈퇴 시 Auth 사용자 삭제에만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# 공개 집계 읽기 경로: supabase(기본) | postgres(로컬·CI 전용, 집계 뷰만 anon 권한으로 읽음)
DATA_BACKEND=supabase
# DATA_BACKEND=postgres 또는 DB 통합 테스트에서 사용
DATABASE_URL=postgres://postgres:postgres@localhost:5432/becomap

# 사이트 주소(이메일 로그인 리다이렉트용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
